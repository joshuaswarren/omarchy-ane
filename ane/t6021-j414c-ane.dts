// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Board overlay for jw14m2-linux (J414c / T6021, M2 Max): enable the ANE
 * engine, its three DARTs, and attach the ANE genpd chain the stock DTB
 * already carries (pmgr+0x4000: ane_td@4008 -> ane_base@4010 -> ane_set1..
 * set4@4018-4030, plus ane_cpu@2e0). Applied with fdtoverlay onto the
 * stock modules DTB; boot.bin is rebuilt with update-m1n1.
 *
 * Provenance (receipts 2026-09-18-t6021-qualification, 2026-09-13-t6001-
 * tm-offset, m1n1 fw/ane.py ps_map):
 *  - engine = ane0 ADT range0 (0x84000000/0x2000000 raw, +0x200000000
 *    translation proven by pmgr low-32 match) + m1n1 constant 0x1c04000
 *    (exact delta on t8103 dtsi and t6001 live) -> 0x285c04000 + 0x24000.
 *  - DART quartet 0x285800000/810000/820000 + 0x4000 each from the same
 *    capture (identical to T6001 live); fourth window 0x285804000 not
 *    split out on T6001 either. SIDs 0 (jw16 live od: <&dart 0> x3).
 *  - IRQs: AIC raw 0x374 (ane) / 0x375 (dart-ane0), AIC2 4-cell,
 *    level-high (family pattern, jw16 live flags=4).
 *  - The SET-window constant stays in the driver (0x28e08c000, m1n1
 *    ps_map["ane0"]); this overlay does not touch the pmgr c000 window.
 */
/dts-v1/;
/plugin/;

/ {
	compatible = "apple,j414c", "apple,t6021";

	fragment@0 {
		target-path = "/soc/power-management@28e080000/power-controller@2e0";

		__overlay__ {
			phandle = <0x1f0>; /* ane_cpu */
		};
	};

	fragment@1 {
		target-path = "/soc/power-management@28e080000/power-controller@4030";

		__overlay__ {
			phandle = <0x1f1>; /* ane_set4 */
		};
	};

	/* fragment@3: ane_sys_mpm@4000 carries no phandle in the stock DTB
	 * and nothing consumes it, so the set1..4 parent cascade (set4 ->
	 * set3 -> .. -> ane_base@4010 -> ane_td@4008 -> ane_sys@260) can
	 * never raise it. ane0's ADT pmgr window (0x8e080000..+0x4034)
	 * frames exactly this six-island chain, so the bound device must
	 * consume it explicitly. Bisect 2026-09-18: first engine read at
	 * 0x285c2400c external-aborted with the five-domain raise; SET
	 * window at 0x28e08c000 read safe (ACTUALs all zero). Applied at
	 * DTS source level only: fdtoverlay renumbers overlay phandles
	 * without remapping raw refs. */
	fragment@3 {
		target-path = "/soc/power-management@28e080000/power-controller@4000";

		__overlay__ {
			phandle = <0x1f5>; /* ane_sys_mpm */
		};
	};

	fragment@2 {
		target-path = "/soc";

		__overlay__ {
			#address-cells = <2>;
			#size-cells = <2>;

			ane_dart0: iommu@285800000 {
				compatible = "apple,t6020-dart", "apple,t8110-dart";
				reg = <0x2 0x85800000 0x0 0x00004000>;
				#iommu-cells = <1>;
				interrupt-parent = <0x15>;
				interrupts = <0 0 885 4>;
				power-domains = <0x18>;
				status = "okay";
			};

			ane_dart1: iommu@285810000 {
				compatible = "apple,t6020-dart", "apple,t8110-dart";
				reg = <0x2 0x85810000 0x0 0x00004000>;
				#iommu-cells = <1>;
				interrupt-parent = <0x15>;
				interrupts = <0 0 885 4>;
				power-domains = <0x1f0>;
				status = "okay";
			};

			ane_dart2: iommu@285820000 {
				compatible = "apple,t6020-dart", "apple,t8110-dart";
				reg = <0x2 0x85820000 0x0 0x00004000>;
				#iommu-cells = <1>;
				interrupt-parent = <0x15>;
				interrupts = <0 0 885 4>;
				power-domains = <0x1f0>;
				status = "okay";
			};

			ane@284000000 {
				compatible = "apple,t6021-ane";
				reg-names = "engine";
				reg = <0x2 0x85c04000 0x0 0x0024000>;
				interrupt-parent = <0x15>;
				interrupt-names = "ane";
				interrupts = <0 0 884 4>;
				iommus = <&ane_dart0 0>, <&ane_dart1 0>, <&ane_dart2 0>;
				power-domains = <0x1f0>,	/* ane_cpu@2e0 */
						<0xb7>,		/* ane_set1@4018 */
						<0xb8>,		/* ane_set2@4020 */
						<0xb9>,		/* ane_set3@4028 */
						<0x1f1>,	/* ane_set4@4030 */
						<0x1f5>;	/* ane_sys_mpm@4000 (fragment@3) */
				status = "okay";
			};
		};
	};
};
