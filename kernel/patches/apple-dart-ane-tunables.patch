From: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
Subject: [PATCH] iommu/apple-dart: write the T6021 ANE bulk-DART tunables at reset (experiment)

Base: AsahiLinux/linux asahi-7.1.13-3 (linux-asahi 7.1.13.asahi3-1).

With apple_dart.ane_tunables=1 on an apple,t6021 machine, the two bulk DARTs
of the ANE (dart-ane1 0x285810000, dart-ane2 0x285820000) get the 19 macOS
ADT dart-tunables words (0x20c, 0x220, 0x224, 0x800-0x83c) as read-modify-
writes in apple_dart_hw_reset(): after the TTBRs are cleared and a full TLB
flush, before streams and translation are enabled. This is the macOS order
(hv trace events 2851-2916). hw_reset runs at probe and on every runtime
resume, so the words survive power cycles of the ane_cpu domain.

The DVA window words 0x300-0x310 are not written: ane_t6021 maps its
buffers below 4 GiB, outside the macOS window.

Default (parameter unset or 0): no DART gets a table, hw_reset is unchanged.

Source of the values: omarchy-ane
receipts/2026-10-01-t6021-macos-vs-linux-mmio/dart-tunables.tsv.
---
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -204,6 +204,7 @@
  * @pgsize: pagesize supported by this DART
  * @supports_bypass: indicates if this DART supports bypass mode
  * @locked: indicates if this DART is locked
+ * @tunables: T6021 ANE tunables written at every reset, or NULL
  * @sid2group: maps stream ids to iommu_groups
  * @iommu: iommu core device
  */
@@ -226,6 +227,7 @@
 	u32 supports_bypass : 1;
 	u32 four_level : 1;
 	u32 locked : 1;
+	const struct apple_dart_tunables *tunables;
 
 	dma_addr_t dma_min;
 	dma_addr_t dma_max;
@@ -549,6 +551,51 @@
 		stream_map, DART_T8110_TLB_CMD_OP_FLUSH_SID);
 }
 
+static bool ane_tunables;
+module_param(ane_tunables, bool, 0444);
+MODULE_PARM_DESC(ane_tunables, "Write the macOS tunables to the T6021 ANE bulk DARTs at reset");
+
+/*
+ * macOS ADT dart-tunables of the T6021 ANE bulk DARTs, written in the macOS
+ * order: TTBRs cleared, full TLB flush, tunables, then streams and TTBRs.
+ * The DVA window (0x300-0x310) is left out because ane_t6021 maps its
+ * buffers below 4 GiB, outside the macOS window.
+ * Source: omarchy-ane receipts/2026-10-01-t6021-macos-vs-linux-mmio/dart-tunables.tsv
+ */
+struct apple_dart_tunables {
+	phys_addr_t base;
+	u32 sid_2_4;
+	u32 sid_5_15;
+};
+
+static const struct apple_dart_tunables apple_dart_t6021_ane_tunables[] = {
+	{ 0x285810000, 0x00030040, 0x00010048 },	/* dart-ane1 (BRD) */
+	{ 0x285820000, 0x00010040, 0x00010040 },	/* dart-ane2 (BWR) */
+};
+
+static void apple_dart_rmw(struct apple_dart *dart, u32 off, u32 mask, u32 val)
+{
+	writel((readl(dart->regs + off) & ~mask) | val, dart->regs + off);
+}
+
+static void apple_dart_apply_tunables(struct apple_dart *dart)
+{
+	const struct apple_dart_tunables *t = dart->tunables;
+	struct apple_dart_stream_map sid0 = { .dart = dart };
+	int i;
+
+	bitmap_set(sid0.sidmap, 0, 1);
+	if (apple_dart_t8110_hw_tlb_command(&sid0, DART_T8110_TLB_CMD_OP_FLUSH_ALL))
+		return;
+
+	apple_dart_rmw(dart, 0x20c, 0xff0000b7, 0xe40000b7);
+	apple_dart_rmw(dart, 0x220, 0x000f0f0f, 0x000f0f0f);
+	apple_dart_rmw(dart, 0x224, 0x00ffffff, 0x00080808);
+	for (i = 0; i < 16; i++)
+		apple_dart_rmw(dart, 0x800 + 4 * i, 0x000f007f,
+			       i < 2 ? 0x00060000 : i < 5 ? t->sid_2_4 : t->sid_5_15);
+}
+
 static int apple_dart_hw_reset(struct apple_dart *dart)
 {
 	struct apple_dart_stream_map stream_map;
@@ -559,6 +606,8 @@
 	bitmap_set(stream_map.sidmap, 0, dart->num_streams);
 	apple_dart_hw_disable_dma(&stream_map);
 	apple_dart_hw_clear_all_ttbrs(&stream_map);
+	if (dart->tunables)
+		apple_dart_apply_tunables(dart);
 
 	/* enable all streams globally since TCR is used to control isolation */
 	for (i = 0; i < BITS_TO_U32(dart->num_streams); i++)
@@ -1317,6 +1366,22 @@
 	return !!(readl(dart->regs + dart->hw->lock) & dart->hw->lock_bit);
 }
 
+static const struct apple_dart_tunables *
+apple_dart_find_tunables(struct apple_dart *dart, struct resource *res)
+{
+	int i;
+
+	if (!ane_tunables || dart->hw->type != DART_T8110 ||
+	    !of_machine_is_compatible("apple,t6021"))
+		return NULL;
+
+	for (i = 0; i < ARRAY_SIZE(apple_dart_t6021_ane_tunables); i++)
+		if (res->start == apple_dart_t6021_ane_tunables[i].base)
+			return &apple_dart_t6021_ane_tunables[i];
+
+	return NULL;
+}
+
 static int apple_dart_probe(struct platform_device *pdev)
 {
 	int ret;
@@ -1415,6 +1480,10 @@
 		goto err_clk_disable;
 	}
 
+	dart->tunables = apple_dart_find_tunables(dart, res);
+	if (dart->tunables)
+		dev_info(dev, "T6021 ANE tunables on\n");
+
 	dart->locked = apple_dart_is_locked(dart);
 	if (!dart->locked) {
 		ret = apple_dart_hw_reset(dart);
