# Maintainer: omarchy-ane
# omarchy-ane-smoke as a package: the qualification kit (omarchy-mlx
# qualification-kit/qualify.py) runs the bare command `omarchy-ane-smoke`, so
# an image without it reports the `ane` step as unavailable with exit 127 on
# machines whose ANE is otherwise ready. The package installs the three pieces
# the script resolves at runtime: the program itself, the omarchy-ane-run
# runner built from tools/, and the h13/h14 add fixtures at the
# /usr/share/omarchy-ane/fixtures paths the script searches. Build from a
# checkout of the omarchy-ane repository:
#   cd packaging/arch/omarchy-ane-smoke && makepkg -f
pkgname=omarchy-ane-smoke
pkgver=${OMARCHY_ANE_PKGVER:-0.4.3.30552e1}
pkgrel=1
pkgdesc="Apple Neural Engine smoke: 20 bit-exact add-fixture calls (omarchy-ane-smoke)"
arch=('aarch64' 'x86_64')
url="https://github.com/joshuaswarren/omarchy-ane"
license=('MIT')
depends=('python')
makedepends=('gcc' 'make')
options=(!strip)
_repo=$startdir/../../..

build() {
	make -C "$_repo/tools" ane-run
}

check() {
	# Parse only: py_compile would drop a __pycache__ into the checkout.
	python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "$_repo/packaging/omarchy-ane-smoke"
}

package() {
	install -Dm755 "$_repo/packaging/omarchy-ane-smoke" "$pkgdir/usr/bin/omarchy-ane-smoke"
	install -Dm755 "$_repo/tools/ane-run" "$pkgdir/usr/bin/omarchy-ane-run"
	install -Dm644 "$_repo/fixtures/h13-anec/add/program-0.anec" "$pkgdir/usr/share/omarchy-ane/fixtures/h13-anec/add/program-0.anec"
	install -Dm644 "$_repo/fixtures/h14-anec/add/program-0.anec" "$pkgdir/usr/share/omarchy-ane/fixtures/h14-anec/add/program-0.anec"
}
