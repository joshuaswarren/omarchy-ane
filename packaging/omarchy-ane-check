#!/usr/bin/env bash
# omarchy-ane-check: report whether the Apple Neural Engine driver is ready.
#
#   omarchy-ane-check              check the running kernel: ANE device-tree
#                                  node, ane.ko built, loaded, bound, and the
#                                  /dev/accel node
#   omarchy-ane-check --installed  check that ane.ko exists for every
#                                  installed kernel with headers (pacman hook)
#
# Read-only. It never loads, unloads, or binds the module.
# Exit 0 when every check passes, 1 when a check fails, 2 on bad usage.
set -u
shopt -s nullglob

fail=0
ok()  { printf '  ok    %s\n' "$*"; }
bad() { printf '  FAIL  %s\n' "$*"; fail=1; }
finish() {
  if (( fail )); then echo "omarchy-ane-check: FAILED"; exit 1; fi
  echo "omarchy-ane-check: ready"; exit 0
}

built() {
  local file
  file=$(modinfo -k "$1" -F filename ane 2>/dev/null)
  if [[ -n $file ]]; then
    ok "ane.ko built for $1: $file (version $(modinfo -k "$1" -F version ane 2>/dev/null))"
  else
    bad "ane.ko is not built for kernel $1. Install the headers for $1, then run: sudo dkms autoinstall -k $1"
  fi
}

case "${1:-}" in
  --installed)
    kernels=(/usr/lib/modules/*/build)
    (( ${#kernels[@]} )) || { bad "no kernel headers are installed, so DKMS cannot build ane.ko"; finish; }
    for b in "${kernels[@]}"; do k=${b%/build}; built "${k##*/}"; done
    finish ;;
  "") ;;
  *) echo "usage: omarchy-ane-check [--installed]" >&2; exit 2 ;;
esac

kver=$(uname -r)
dt=/sys/firmware/devicetree/base
echo "omarchy-ane-check: kernel $kver"

# 1. ANE node. Without it nothing else can pass, so stop here.
compat=""
for f in "$dt"/ane*@*/compatible "$dt"/*/ane*@*/compatible; do
  c=$(tr '\0' '\n' <"$f" | grep -m1 -E '^apple,t[0-9a-z]+-ane$') || continue
  st=${f%/compatible}/status status=okay
  [[ -e $st ]] && status=$(tr -d '\0' <"$st")
  [[ $status == okay ]] && { compat=$c; break; }
done
# Where the node comes from: omarchy-ane-dt status compares the running
# kernel's board device tree with omarchy-ane's overlay.
dtool=$(dirname -- "$(realpath -- "$0")")/omarchy-ane-dt
[[ -x $dtool ]] || dtool=$(command -v omarchy-ane-dt || true)
origin=""
[[ -z $dtool ]] || origin=$("$dtool" status 2>/dev/null | sed -n 's/.* source=\([a-z]*\) .*/\1/p')
if [[ ! -d $dt ]]; then
  bad "no device tree: this is not an Apple Silicon Linux system"; finish
elif [[ -z $compat ]]; then
  case $origin in
    kernel) bad "no ANE node in the running device tree, but the kernel's DTB has one. m1n1 has an older device tree. Run: sudo update-m1n1, then reboot." ;;
    overlay) bad "no ANE node in the running device tree, but the omarchy-ane overlay has one. m1n1 has an older device tree. Run: sudo update-m1n1, then reboot." ;;
    *) bad "no ANE node: neither the kernel's DTB nor the omarchy-ane overlay has one. Run: sudo omarchy-ane-dt apply" ;;
  esac
  finish
fi
case $origin in
  kernel) ok "ANE device-tree node: $compat (DTB has node: kernel)" ;;
  overlay) ok "ANE device-tree node: $compat (DTB has node: omarchy-ane overlay)" ;;
  *) ok "ANE device-tree node: $compat (from a device tree outside the kernel package and omarchy-ane)" ;;
esac

# 2. Module built for the running kernel.
built "$kver"

# 3. Module loaded.
if [[ -d /sys/module/ane ]]; then
  ok "ane is loaded (version $(cat /sys/module/ane/version 2>/dev/null))"
  disk=$(modinfo -k "$kver" -F srcversion ane 2>/dev/null)
  live=$(cat /sys/module/ane/srcversion 2>/dev/null)
  if [[ -n $disk && -n $live && $disk != "$live" ]]; then
    echo "  note  the loaded ane differs from the installed ane.ko. Reboot to load the new one. Do not rmmod ane."
  fi
else
  bad "ane is not loaded. Load it with: sudo modprobe ane"
fi

# 4. Driver bound to the ANE platform device.
dev=""
for l in /sys/bus/platform/drivers/ane/*; do
  [[ -L $l && ${l##*/} != module ]] && { dev=${l##*/}; break; }
done
if [[ -n $dev ]]; then
  ok "ane is bound to $dev"
else
  bad "ane is bound to no device. Read the reason with: journalctl -k -g ane"
fi

# 5. Device node. Every user must be able to open it. The package adds no
#    udev rule: systemd's 50-udev-default.rules makes accel nodes mode 0666.
node=""
for s in /sys/class/accel/accel*; do
  [[ $(readlink "$s/device/driver") == */ane ]] && { node=/dev/accel/${s##*/}; break; }
done
if [[ -z $node || ! -c $node ]]; then
  bad "no /dev/accel node from ane"
else
  mode=$(stat -c '%A %U:%G' "$node")
  if [[ $mode == c??????rw?\ * ]]; then
    ok "$node present ($mode); every user can open it"
  else
    bad "$node is $mode, so not every user can open it. systemd's default rule makes accel nodes mode 0666. A udev rule on this system changed that."
  fi
fi

finish
