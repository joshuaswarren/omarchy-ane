#!/usr/bin/env python3
"""omarchy-ane-firmware-fetch: install this Mac's ANE firmware from Apple.

M2 family and H16 (M4) family. T6020, T6021 and T6022 (M2 Pro, Max, Ultra):
Linux must start the ANE firmware there, and the driver accepts exactly one
image: the selene payload from the macOS 13.5 (22G74) stub that every Omarchy
M1/M2 install boots; its BuildManifest gives that one file to the die-0 ANE of
all three. T8112 (M2): the 13.5 BuildManifest gives h14_ane_fw_bia_j4xx to
j413, j415, j473 and j493 (receipts/2026-10-01-t8112-ane); ane_t6021 loads it
(UNTESTED, receipts/2026-10-01-t8112-optin). T8132, T6040, T6041 (M4 family):
the macOS 27.0 (26A428) BuildManifest gives h16_ane_fw_leto_j7x to T8132 and
t604x_ane_fw_aether_brvx to T6040/T6041 (receipts/2026-10-03-ane-h16); the
ane_h16 module pins those payload bytes. This tool
reads the stub version from the device tree, maps it to a pinned IPSW URL,
range-fetches only the ANE member (about 5 MB of a 12.9 GB IPSW), unwraps the
IM4P, and installs the payload only when its size and SHA-256 equal the pin.
The stub version must also be the version of the IPSW a chip's pin comes from:
a Mac preloads its ANE firmware from its own stub. H15 chips (T8122, T6030,
T6031, T6034) refuse: their stub image identity and payload SHA-256 are
unmeasured (ane/h15/README-bringup.md).
M1-family chips need nothing: iBoot preloads their ANE firmware.

We never redistribute Apple firmware. Each Mac fetches its own copy.
Dependencies: Python 3, stdlib only. The pinned IM4Ps ("anef") store their
Mach-O payload uncompressed, so no LZFSE decoder is needed.

  sudo omarchy-ane-firmware-fetch [--root DIR]
  omarchy-ane-firmware-fetch --check [--root DIR]
  omarchy-ane-firmware-fetch --hook            (90-omarchy-ane-firmware.hook)

--root reads the device tree from DIR/sys/... and installs under DIR/usr/lib/
firmware (for tests). The kernel loads the Asahi vendor firmware copy
(usr/lib/firmware/vendor/<name>) before usr/lib/firmware/<name>. A vendor copy
that matches the pin is enough: nothing is fetched. A vendor copy that does not
match is a problem, because the driver refuses it and never sees our copy.
Exit 0: installed, already installed, or not needed. Exit 1: refused; nothing
was written. --check reads only the installed files: exit 0 when the copy the
kernel loads matches the pin. --hook fetches only on a chip whose ANE is on
by default (DEFAULT_ON); what it cannot do there is a note, not an error, and
the ANE stays off until a fetch succeeds and the Mac reboots.
"""
import argparse
import hashlib
import http.client
import os
import re
import sys
import tempfile
import urllib.request
import zipfile
from pathlib import Path

# chip -> (IPSW member, installed name, payload size, payload SHA-256, IPSW
# macOS version). These are the driver's pins: ane/t6021/ane_fw_validate.h
# ane_fw_selene and ane_fw_bia; ane/h16/ane_h16_soc.c ane_fw_leto and
# ane_fw_aether. Change them together (tools/test_ane_firmware_fetch.py).
SELENE = ("Firmware/ane/t602x_ane0_fw_selene_rc4x.im4p", "apple/ane/t602x_ane0_fw_selene_rc4x.macho",
          0x4C5B28, "a9c4b771294a6b115624d9480a6248d0899a1681a575e865070b87a3248427bc", "13.5")
BIA = ("Firmware/ane/h14_ane_fw_bia_j4xx.im4p", "apple/ane/h14_ane_fw_bia_j4xx.macho",
       0x4B5B38, "af587dfa96b1e01d2b2e0f9f776e5dbefebb44c7968b86fff7d2b19c4cbef0dd", "13.5")
LETO = ("Firmware/ane/h16_ane_fw_leto_j7x.im4p", "apple/ane/h16_ane_fw_leto_j7x.macho",
        0x17C000, "4b330c5fd3548fb534ded5e7030c64b2ee3c3feb8ad859c23d87dcb82947abd2", "27.0")
AETHER = ("Firmware/ane/t604x_ane_fw_aether_brvx.im4p", "apple/ane/t604x_ane_fw_aether_brvx.macho",
          0x17C000, "8659271a3173ca1c816841b212ac406a6516f74f51d08f196327560cb1f6b925", "27.0")
FETCH = {"apple,t6020": SELENE, "apple,t6021": SELENE, "apple,t6022": SELENE, "apple,t8112": BIA,
         "apple,t8132": LETO, "apple,t6040": AETHER, "apple,t6041": AETHER}
MEMBER_MAX = 16 << 20
# The M3 family: the 27.0 IPSW carries h15_ane_fw_themis_j51y and
# t603x_ane0_fw_erebus_* (IM4P hashes in the b0 receipts), but the stub image
# iBoot preloads on an H15 Linux boot is unmeasured and no raw payload SHA-256
# is pinned (ane/h15/README-bringup.md). Refuse until a receipt pins both.
H15 = frozenset(("apple,t8122", "apple,t6030", "apple,t6031", "apple,t6034"))

# Stub macOS version -> IPSW, from AsahiLinux/asahi-installer src/main.py
# IPSW_VERSIONS. Apple's mesu catalog no longer lists 13.5, so the URL is pinned.
IPSW = {
    "13.5": "https://updates.cdn-apple.com/2023SummerFCS/fullrestores/032-69606/"
            "D3E05CDF-E105-434C-A4A1-4E3DC7668DD0/UniversalMac_13.5_22G74_Restore.ipsw",
    "27.0": "https://updates.cdn-apple.com/2026FallFCS/afcfc88e-bbe6-44bf-a5da-07c56eebc06c/"
            "UniversalMac_27.0_26A428_Restore.ipsw",
}
NO_FETCH = ("apple,t8103", "apple,t6000", "apple,t6001", "apple,t6002")
# FETCH chips whose ANE overlay is enabled in packaging/dt/overlays (the
# others are opt-in or not installed); tools/test_ane_m2.py checks that the
# two agree.
DEFAULT_ON = ("apple,t6020", "apple,t6021")
# The Asahi initramfs mounts the vendor firmware package (vendorfw on the ESP)
# here, and the kernel firmware loader searches it before usr/lib/firmware.
VENDOR = "usr/lib/firmware/vendor"
TIMEOUT = 30


class Refuse(Exception):
    pass


def dt_strings(path):
    try:
        return [s for s in path.read_bytes().decode("ascii", "replace").split("\0") if s]
    except OSError as e:
        raise Refuse(f"cannot read {path}: {e.strerror}. Is this an Apple Silicon Linux system?")


def stub_version(text):
    m = re.match(r"\s*(\d+\.\d+(?:\.\d+)?)", text)
    if not m:
        raise Refuse(f"cannot parse asahi,os-fw-version {text!r}")
    return m.group(1)


class RangeFile:
    """Read-only, seekable view of a URL. Every read is one HTTP range request."""

    def __init__(self, url):
        self.url, self.pos = url, 0
        with self._get(0, 0) as head:  # closes without reading a non-206 body
            total = head.headers.get("Content-Range", "").rpartition("/")[2]
            if head.status != 206 or not total.isdigit():
                raise Refuse(f"{url} does not serve range requests (HTTP {head.status})")
        self.size = int(total)

    def _get(self, start, end):
        req = urllib.request.Request(self.url, headers={"Range": f"bytes={start}-{end}"})
        return urllib.request.urlopen(req, timeout=TIMEOUT)

    def seekable(self):
        return True

    def tell(self):
        return self.pos

    def seek(self, offset, whence=0):
        self.pos = (offset, self.pos + offset, self.size + offset)[whence]
        return self.pos

    def read(self, n=-1):
        if n is None or n < 0 or n > self.size - self.pos:
            n = self.size - self.pos
        if n <= 0:
            return b""
        with self._get(self.pos, self.pos + n - 1) as r:
            if r.status != 206:
                raise OSError(f"range request at {self.pos} got HTTP {r.status}")
            data = r.read()
        if len(data) != n:
            raise OSError(f"short range read at {self.pos}: {len(data)} of {n} bytes")
        self.pos += n
        return data


def fetch_member(url, member):
    with zipfile.ZipFile(RangeFile(url)) as z:
        info = z.getinfo(member)
        if info.file_size > MEMBER_MAX:
            raise Refuse(f"{member} is {info.file_size} bytes; expected about 5 MB")
        return z.read(info)  # zipfile checks the member's CRC-32


def der(buf, pos):
    """One DER header at pos: (tag, content start, content end)."""
    if pos + 2 > len(buf):
        raise Refuse("IM4P is truncated")
    tag, length, pos = buf[pos], buf[pos + 1], pos + 2
    if length & 0x80:
        k = length & 0x7F
        length, pos = int.from_bytes(buf[pos:pos + k], "big"), pos + k
    if pos + length > len(buf):
        raise Refuse("IM4P is truncated")
    return tag, pos, pos + length


def im4p_payload(blob):
    """IM4P = SEQUENCE { "IM4P", type, description, OCTET STRING payload, ... }."""
    tag, pos, end = der(blob, 0)
    fields = []
    while tag == 0x30 and pos < end and len(fields) < 4:
        field = der(blob, pos)
        fields.append(field)
        pos = field[2]
    if len(fields) < 4 or blob[fields[0][1]:fields[0][2]] != b"IM4P" or fields[3][0] != 0x04:
        raise Refuse("the IPSW member is not an IM4P")
    return blob[fields[3][1]:fields[3][2]]


def verify(data, size, sha256):
    digest = hashlib.sha256(data).hexdigest()
    if len(data) != size or digest != sha256:
        raise Refuse(f"got {len(data)} bytes, sha256 {digest}; the pin is {size} bytes, sha256 {sha256}")
    return digest


def install(data, dest):
    dest.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=dest.parent, prefix=".fetch-")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, dest)
    except BaseException:
        os.unlink(tmp)
        raise


def soc(root):
    chips = dt_strings(root / "sys/firmware/devicetree/base/compatible")
    return next((c for c in chips if re.fullmatch(r"apple,t\d+", c)), "unknown")


def vendor_copy(root, name, size, sha256):
    """(path, None) when the vendor copy matches the pin, (None, None) when
    there is none, and (None, problem) when it does not match."""
    path = root / VENDOR / name
    try:
        verify(path.read_bytes(), size, sha256)
    except FileNotFoundError:
        return None, None
    except (OSError, Refuse) as e:
        return None, (f"{path}: {e}. The kernel loads this vendor copy before {root / 'usr/lib/firmware' / name}, "
                      "so the driver refuses the firmware. Rebuild the vendor firmware package so that it holds "
                      "the pinned file or none (sudo asahi-fwupdate), then reboot")
    return path, None


def h15_refusal(chip):
    return (f"{chip}: no pinned ANE payload. The IPSW records the H15 members "
            "(h15_ane_fw_themis_j51y, t603x_ane0_fw_erebus_ls5x/pc5x), but the stub image iBoot "
            "preloads on an H15 Linux boot is unmeasured and no raw payload SHA-256 is pinned "
            "(ane/h15/README-bringup.md). Run omarchy-ane-probe and send its os_fw_version with "
            "the first H15 report. Nothing was installed")


def run(root, hook=False):
    """Install the firmware. Returns the vendor-copy problem, or None."""
    dt = root / "sys/firmware/devicetree/base"
    chip = soc(root)
    if chip in NO_FETCH:
        print(f"{chip}: iBoot preloads the ANE firmware on M1 chips. Nothing to fetch.")
        return None
    if hook and chip not in DEFAULT_ON:
        print(f"{chip}: the ANE is not on by default here. Nothing fetched.")
        return None
    if chip in H15:
        raise Refuse(h15_refusal(chip))
    if chip not in FETCH:
        raise Refuse(f"{chip}: no pinned ANE firmware for this chip")
    # The die-1 ANE of an Ultra board boots its own image (Ap,ANE1,
    # t602x_ane1_fw_selene_rc4x) whose SHA-256 is a missing fact
    # (docs/ultra-die1.md §9.2): the driver requests it by name and
    # validates against the die-0 pin, so a non-identical image refuses at
    # load. Nothing to fetch until a capture pins the bytes.
    if (dt / "soc@2200000000/ane@284000000").is_dir():
        raise Refuse("no pin for T6022 die 1: t602x_ane1_fw_selene_rc4x has "
                     "no recorded SHA-256 (docs/ultra-die1.md §9.2); the die-1 "
                     "node is present and the driver will validate its image "
                     "against the die-0 pin at load")

    member, name, size, sha256, ipsw_version = FETCH[chip]
    vendor, shadow = vendor_copy(root, name, size, sha256)
    if vendor:
        print(f"{vendor} (Asahi vendor firmware) matches the pin. Nothing to fetch.")
        return None
    dest = root / "usr/lib/firmware" / name
    try:
        verify(dest.read_bytes(), size, sha256)
        print(f"{dest} is already installed and matches the pin.")
        return shadow
    except (OSError, Refuse):
        pass
    parent = dest.parent
    while not parent.exists():
        parent = parent.parent
    if not os.access(parent, os.W_OK):
        raise Refuse(f"cannot write {parent}. Run with sudo")

    version = stub_version("".join(dt_strings(dt / "chosen/asahi,os-fw-version")))
    url = IPSW.get(version)
    if url is None:
        raise Refuse(f"stub macOS {version}: no pinned ANE image. Pinned stub versions: "
                     f"{', '.join(sorted(IPSW))}")
    if version != ipsw_version:
        raise Refuse(f"stub macOS {version}: the pinned {name} payload is from the macOS "
                     f"{ipsw_version} IPSW. A Mac preloads its ANE firmware from its own stub, "
                     "so only the stub version a pin was measured on applies")

    print(f"stub macOS {version}: fetching {member}")
    try:
        blob = fetch_member(url, member)
    except (OSError, http.client.HTTPException, zipfile.BadZipFile, KeyError) as e:
        raise Refuse(f"cannot fetch from Apple's CDN: {e}. Check the network and try again")
    data = im4p_payload(blob)
    digest = verify(data, size, sha256)
    try:
        install(data, dest)
    except OSError as e:
        raise Refuse(f"cannot write {dest}: {e.strerror}")
    print(f"installed {dest} ({len(data)} bytes, sha256 {digest})")
    return shadow


def check(root):
    chip = soc(root)
    if chip in H15:
        raise Refuse(h15_refusal(chip))
    if chip not in FETCH:
        raise Refuse(f"{chip}: no pinned ANE firmware for this chip")
    _, name, size, sha256 = FETCH[chip][:4]
    vendor, shadow = vendor_copy(root, name, size, sha256)
    if shadow:
        raise Refuse(shadow)
    if vendor:
        print(f"{vendor} (Asahi vendor firmware) matches the pin")
        return
    dest = root / "usr/lib/firmware" / name
    try:
        verify(dest.read_bytes(), size, sha256)
    except FileNotFoundError:
        raise Refuse(f"{dest} is missing. Run: sudo omarchy-ane-firmware-fetch")
    except Refuse as e:
        raise Refuse(f"{dest}: {e}. Run: sudo omarchy-ane-firmware-fetch")
    print(f"{dest} matches the pin")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--root", type=Path, default=Path("/"), help="system root (tests)")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="check the installed files only (no network)")
    mode.add_argument("--hook", action="store_true", help="run from the pacman hook")
    args = ap.parse_args(argv)
    try:
        if args.check:
            check(args.root)
        else:
            shadow = run(args.root, args.hook)
            if shadow:
                print(f"omarchy-ane-firmware-fetch: {shadow}", file=sys.stderr)
                return 0 if args.hook else 1
    except Refuse as e:
        if args.check:
            print(f"omarchy-ane-firmware-fetch: {e}", file=sys.stderr)
            return 1
        print(f"omarchy-ane-firmware-fetch: {e}\nNothing was installed.", file=sys.stderr)
        if args.hook:
            print("The ANE stays off until this succeeds: sudo omarchy-ane-firmware-fetch, then reboot.",
                  file=sys.stderr)
            return 0
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
