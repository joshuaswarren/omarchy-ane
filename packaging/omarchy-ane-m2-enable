#!/usr/bin/env python3
"""omarchy-ane-m2-enable: opt this M2 Max (T6021) in to the ANE driver.

ane_t6021 is built and installed with the package, but it does not load:
/etc/modprobe.d/ane_t6021.conf makes its autoload run /bin/false, and the
T6021 device-tree overlay is opt-in. Once ane_t6021 starts the ANE firmware,
it cannot be unloaded. Only a reboot releases it.

  sudo omarchy-ane-m2-enable            opt in
  sudo omarchy-ane-m2-enable --disable  undo the opt-in
  omarchy-ane-m2-enable --status        print the opt-in state (one line)

Opt-in refuses, and changes nothing, unless: this Mac is a T6021; ane_t6021.ko
is built for the kernel; that kernel can drive the ANE mailbox (its
apple-mailbox polls TX, or ane_t6021 has its own mailbox controller); and
omarchy-ane-firmware-fetch installs the pinned firmware. Then it writes
"ane-t6021" to /etc/omarchy-platform/dtb-overlays.opt-in, applies the overlay
through omarchy-ane-dt, and comments out the block in ane_t6021.conf. It never
runs update-m1n1 and never loads the module: it tells you to run
"sudo update-m1n1", then reboot.

--disable restores the block, removes the opt-in and the fetched firmware, and
takes the overlay out. A loaded ane_t6021 stays loaded until the reboot.

--root DIR reads and writes below DIR (tests); --kver KVER checks that kernel
instead of the running one. Exit 0: done. Exit 1: refused; nothing changed.
"""
import argparse
import glob
import hashlib
import os
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

sys.dont_write_bytecode = True

GATE = "etc/modprobe.d/ane_t6021.conf"
BLOCK = "install ane_t6021 /bin/false"
LIFTED = f"# {BLOCK}  (lifted by omarchy-ane-m2-enable)"
OPT_IN_KEY = "ane-t6021"
OVERLAY = "usr/lib/omarchy-platform/dtb-overlays/t6021/omarchy-ane.dtbo"
MAILBOX_HEADER = "include/linux/soc/apple/mailbox.h"
MODULE_MAILBOX_ALIAS = "apple,t6021-ane-mailbox"
REBOOT_RULE = ("Once ane_t6021 starts the ANE firmware, it cannot be unloaded. "
               "Only a reboot releases it. Do not rmmod it.")


def sibling(name):
    """A packaging tool next to this one (installed: /usr/bin; source tree: packaging/)."""
    here = Path(os.path.realpath(__file__)).parent
    path = here / name
    spec = spec_from_loader(name.replace("-", "_"), SourceFileLoader(name.replace("-", "_"), str(path)))
    module = module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


dt = sibling("omarchy-ane-dt")
fetch = sibling("omarchy-ane-firmware-fetch")
Refuse = dt.Refuse


def is_t6021(root):
    try:
        compat = (root / "sys/firmware/devicetree/base/compatible").read_bytes().decode().split("\0")
    except OSError:
        raise Refuse("no device tree in /sys/firmware/devicetree: not an Apple Silicon Linux system")
    chip = next((c for c in compat if c.startswith("apple,t")), "unknown")
    return chip == "apple,t6021", chip


def module_file(root, kver):
    found = sorted(glob.glob(str(root / "usr/lib/modules" / kver / "**" / "ane_t6021.ko*"), recursive=True))
    return Path(found[0]) if found else None


def module_aliases(path):
    out = subprocess.run(["modinfo", "-F", "alias", str(path)], capture_output=True, text=True)
    return out.stdout.split() if out.returncode == 0 else []


def mailbox(root, kver):
    """How KVER can drive the ANE mailbox: "kernel", "module", or None."""
    header = root / "usr/lib/modules" / kver / "build" / MAILBOX_HEADER
    try:
        if "poll_tx" in header.read_text():
            return "kernel"
    except OSError:
        pass
    ko = module_file(root, kver)
    if ko and any(MODULE_MAILBOX_ALIAS in alias for alias in module_aliases(ko)):
        return "module"
    return None


def gate_blocked(root):
    try:
        return any(line.strip() == BLOCK for line in (root / GATE).read_text().splitlines())
    except FileNotFoundError:
        return False


def write_file(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.omarchy-ane")
    tmp.write_text(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def set_gate(root, blocked):
    path = root / GATE
    try:
        lines = path.read_text().splitlines()
    except FileNotFoundError:
        lines = []
    if blocked:
        lines = [BLOCK if line.strip() in (LIFTED, f"# {BLOCK}") else line for line in lines]
        if BLOCK not in lines:
            lines.append(BLOCK)
    else:
        lines = [LIFTED if line.strip() == BLOCK else line for line in lines]
    write_file(path, "".join(f"{line}\n" for line in lines))


def set_opt_in(root, present):
    path = root / dt.OPT_IN
    keys = sorted(dt.opted_in(root) | {OPT_IN_KEY} if present else dt.opted_in(root) - {OPT_IN_KEY})
    if keys:
        write_file(path, "".join(f"{key}\n" for key in keys))
    else:
        path.unlink(missing_ok=True)


def firmware_path(root):
    return root / "usr/lib/firmware" / fetch.FIRMWARE


def firmware_state(root):
    try:
        data = firmware_path(root).read_bytes()
    except FileNotFoundError:
        return "absent"
    return "pinned" if len(data) == fetch.PIN_SIZE and hashlib.sha256(data).hexdigest() == fetch.PIN_SHA256 else "mismatch"


def writable(root):
    etc = root / "etc"
    if not os.access(etc if etc.exists() else root, os.W_OK):
        raise Refuse("cannot write /etc. Run with sudo")


def enable(root, kver):
    ok, chip = is_t6021(root)
    if not ok:
        raise Refuse(f"{chip}: this command is for the M2 Max (apple,t6021) only")
    writable(root)
    mac = dt.omarchy_mac(root)
    if mac is False:
        raise Refuse("this omarchy-mac-boot has no device tree overlay support (omacom/omarchy-mac#677), "
                     "so omarchy update would refuse the T6021 node")
    if not (root / OVERLAY).is_file():
        raise Refuse(f"/{OVERLAY} is missing; reinstall the omarchy-ane package")
    if module_file(root, kver) is None:
        raise Refuse(f"ane_t6021.ko is not built for kernel {kver}. Install the headers for {kver}, "
                     f"then run: sudo dkms autoinstall -k {kver}")
    how = mailbox(root, kver)
    if how is None:
        raise Refuse(f"kernel {kver} cannot drive the ANE mailbox: its apple-mailbox does not poll TX "
                     f"(no poll_tx in {MAILBOX_HEADER}), and ane_t6021 has no mailbox controller of its own")
    had_firmware = firmware_path(root).exists()
    try:
        fetch.run(root)
    except fetch.Refuse as e:
        raise Refuse(f"firmware: {e}")
    try:
        set_opt_in(root, True)
        dt.apply(root, None)
    except (Refuse, OSError) as e:
        set_opt_in(root, False)
        if not had_firmware:
            firmware_path(root).unlink(missing_ok=True)
        raise Refuse(f"the T6021 overlay did not apply: {e}")
    set_gate(root, blocked=False)
    print(f"omarchy-ane-m2-enable: ane_t6021 may load on the next boot (kernel {kver}, mailbox: {how}).")
    print(REBOOT_RULE)
    print("m1n1 does not have the T6021 node yet. Run: sudo update-m1n1, then reboot.")


def disable(root):
    writable(root)
    set_gate(root, blocked=True)
    set_opt_in(root, False)
    try:
        dt.apply(root, None)
    except Refuse as e:
        print(f"omarchy-ane-m2-enable: overlay: {e}", file=sys.stderr)
    firmware_path(root).unlink(missing_ok=True)
    print("omarchy-ane-m2-enable: ane_t6021 is blocked again, the T6021 overlay is off, and the firmware is removed.")
    if (root / "sys/module/ane_t6021").exists():
        print("ane_t6021 is loaded now and stays loaded until the reboot. " + REBOOT_RULE)
    print("Run: sudo update-m1n1, then reboot.")


def status(root, kver):
    loaded = "yes" if (root / "sys/module/ane_t6021").exists() else "no"
    overlay = "on" if OPT_IN_KEY in dt.opted_in(root) else "off"
    print(f"module={'blocked' if gate_blocked(root) else 'enabled'} firmware={firmware_state(root)} "
          f"overlay={overlay} mailbox={mailbox(root, kver) or 'none'} loaded={loaded} kernel={kver}")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--disable", action="store_true", help="undo the opt-in")
    mode.add_argument("--status", action="store_true", help="print the opt-in state")
    ap.add_argument("--root", type=Path, default=Path("/"))
    ap.add_argument("--kver", default=os.uname().release)
    args = ap.parse_args(argv)
    try:
        if args.status:
            status(args.root, args.kver)
        elif args.disable:
            disable(args.root)
        else:
            enable(args.root, args.kver)
    except Refuse as e:
        print(f"omarchy-ane-m2-enable: {e}\nNothing was changed.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
