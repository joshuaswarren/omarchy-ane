#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright 2026 Joshua Warren
# omarchy-ane-probe: the three-command probe board owners run for issue #304.
#
#   1. ANE device-tree presence (node path, status, die)
#   2. driver version (package, module, loaded/bound, /dev/accel)
#   3. one model run attempt (the packaged fp16 add smoke, or an honest
#      "no run possible" line naming the reason)
#
# Read-only: it never writes a device-tree property, a module parameter, or
# an MMIO word, and it needs no privileges. Run it and paste the report block
# into https://github.com/joshuaswarren/omarchy-ane/issues/304
#
# Output schema "ane-probe.v1": one `key: value` line per fact. Keys, in
# emission order: schema, mac-model, kernel, soc, ane-dt[N]|ane-dt,
# driver-package, driver-module[NAME]|driver-module, dev-accel, model-run,
# model-run-json (only when the smoke emits a JSON line). The schema line is
# always first inside the --- markers; new keys append at the end.
#
# --self-test runs the script against fixture device trees and stub tools in
# a temp dir and asserts every failure mode line. Override hooks used by it
# (and by anyone replaying a captured tree): DT, SYS_MODULE, DEV_ACCEL,
# PROBE_SMOKE, PROBE_CHECK (set-but-empty = unavailable).
set -u

SCHEMA=ane-probe.v1
HERE=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
DT=${DT:-/sys/firmware/devicetree/base}
SYS_MODULE=${SYS_MODULE:-/sys/module}
SYS_PLATFORM_DRIVERS=${SYS_PLATFORM_DRIVERS:-/sys/bus/platform/drivers}
DEV_ACCEL=${DEV_ACCEL:-/dev/accel}
MODULES="ane ane_t6021 ane_h15 ane_h16 ane_h18"
# Ultra die 1 is die 0 + 0x20_0000_0000 on every window (receipt
# 2026-10-03-ultra-die1); the ANE node reg[0] floor-divided by it names the die.
DIE_STRIDE=137438953472

report() { printf '%s: %s\n' "$1" "$2"; }

first_string() {
	# First NUL-terminated string of a device-tree property, or a default.
	local s
	s=$(tr '\0' '\n' 2>/dev/null <"$1" | sed -n '1p')
	printf '%s' "${s:-$2}"
}

node_is_ane() {
	# The ANE node's compatible ends in -ane (apple,t8103-ane, ...).
	tr '\0' '\n' <"$1/compatible" 2>/dev/null | grep -q '\-ane$'
}

node_die() {
	local hex
	hex=$(od -An -v -tx1 -N8 "$1/reg" 2>/dev/null | tr -d ' \n')
	[ ${#hex} -ge 16 ] || { printf '?'; return; }
	printf '%d' $(( (0x${hex:0:8} * 4294967296 + 0x${hex:8:8}) / DIE_STRIDE ))
}

if [ "${1:-}" = --self-test ]; then
	# Exercise every failure-mode line against fixtures in a temp dir.
	t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
	fails=0
	ok() { if grep -qF "$2" "$3"; then printf 'ok   %s\n' "$1"; else printf 'FAIL %s — missing "%s"\n' "$1" "$2"; fails=$((fails+1)); fi; }
	run() { DT=$2 SYS_MODULE=$t/sysmod SYS_PLATFORM_DRIVERS=$t/sysdrv DEV_ACCEL=$t/accel PROBE_SMOKE=${3-} PROBE_CHECK=${4-} bash "$0" >"$1"; }
	mkdir -p "$t/sysmod" "$t/sysdrv" "$t/accel" "$t/empty-dt" "$t/dt/arm-io/ane0" "$t/dt/arm-io/ane1"
	printf 'Mac14,13\0' >"$t/dt/model"
	printf 'apple,t6021\0apple,j475c\0' >"$t/dt/compatible"
	printf 'apple,t6021-ane\0apple,ane\0' >"$t/dt/arm-io/ane0/compatible"
	printf 'okay\0' >"$t/dt/arm-io/ane0/status"
	printf '\x00\x00\x00\x02\x84\x00\x00\x00' >"$t/dt/arm-io/ane0/reg"
	printf 'apple,t6021-ane\0' >"$t/dt/arm-io/ane1/compatible"
	printf 'disabled\0' >"$t/dt/arm-io/ane1/status"
	printf '\x00\x00\x00\x22\x84\x00\x00\x00' >"$t/dt/arm-io/ane1/reg"
	cat >"$t/smoke-fail" <<'EOF'
#!/usr/bin/env bash
echo "mailbox timeout"
exit 1
EOF
	cat >"$t/smoke-pass" <<'EOF'
#!/usr/bin/env bash
echo "fp16 add"
echo '{"result":"pass"}'
exit 0
EOF
	cat >"$t/check-pass" <<'EOF'
#!/usr/bin/env bash
echo "check ok"
exit 0
EOF
	chmod +x "$t/smoke-fail" "$t/smoke-pass" "$t/check-pass"

	run "$t/o1" "$t/missing-dt" '' ''
	ok "no device tree" "no device tree at" "$t/o1"
	run "$t/o2" "$t/empty-dt" '' ''
	ok "no ane node" "no ANE node in the live device tree" "$t/o2"
	run "$t/o3" "$t/dt" '' ''
	ok "schema" "schema: ane-probe.v1" "$t/o3"
	ok "die0 node" "/arm-io/ane0 status=okay die=0" "$t/o3"
	ok "die1 node" "/arm-io/ane1 status=disabled die=1" "$t/o3"
	ok "no modules" "driver-module: none installed" "$t/o3"
	ok "no accel" "dev-accel: no /dev/accel node" "$t/o3"
	ok "no smoke" "model-run: NOT-RUN" "$t/o3"
	run "$t/o4" "$t/dt" "$t/smoke-fail" ''
	ok "smoke fail" "model-run: FAIL — mailbox timeout" "$t/o4"
	run "$t/o5" "$t/dt" "$t/smoke-pass" ''
	ok "smoke pass" "model-run: PASS — fp16 add" "$t/o5"
	ok "smoke json" 'model-run-json: {"result":"pass"}' "$t/o5"
	run "$t/o6" "$t/dt" '' "$t/check-pass"
	ok "check fallback" "model-run: PASS — check ok" "$t/o6"
	printf '%s\n' "---"
	if [ "$fails" -eq 0 ]; then echo "self-test: all checks passed"; else echo "self-test: $fails FAILED"; fi
	exit "$fails"
fi

echo "ANE board probe for issue #304 — paste the block between the markers"
echo "--- ane-probe $(date -u +%FT%TZ) ---"
report schema "$SCHEMA"

# --- Probe 1: ANE device-tree presence -------------------------------------
report mac-model "$(first_string "$DT/model" unknown)"
report kernel "$(uname -r)"
soc=$(tr '\0' '\n' 2>/dev/null <"$DT/compatible" | sed -n 's/^apple,\(t[0-9]*\).*$/\1/p' | head -1)
report soc "${soc:-none}"
if [ -d "$DT" ]; then
	found=0
	while IFS= read -r -d '' compat; do
		node=${compat%/compatible}
		node_is_ane "$node" || continue
		found=$((found + 1))
		report "ane-dt[$found]" "${node#"$DT"} status=$(first_string "$node/status" okay) die=$(node_die "$node")"
	done < <(find "$DT" -name compatible -print0 2>/dev/null)
	[ "$found" -gt 0 ] || report ane-dt "no ANE node in the live device tree"
else
	report ane-dt "no device tree at $DT (not an Apple Silicon boot?)"
fi

# --- Probe 2: driver version ------------------------------------------------
if command -v pacman >/dev/null 2>&1; then
	report driver-package "$(pacman -Q omarchy-ane-dkms 2>/dev/null || printf 'omarchy-ane-dkms not installed')"
else
	report driver-package "no pacman on this system"
fi
seen=0
for m in $MODULES; do
	if [ -d "$SYS_MODULE/$m" ]; then
		seen=1
		ver=$(modinfo -F version "$m" 2>/dev/null | head -1)
		src=$(cat "$SYS_MODULE/$m/srcversion" 2>/dev/null)
		bound=$(find "$SYS_PLATFORM_DRIVERS/$m" -mindepth 1 -maxdepth 1 -type l ! -name module 2>/dev/null | wc -l)
		report "driver-module[$m]" "version=${ver:-?} srcversion=${src:-?} loaded bound=$bound"
	elif command -v modinfo >/dev/null 2>&1 && modinfo "$m" >/dev/null 2>&1; then
		seen=1
		report "driver-module[$m]" "installed, not loaded (version $(modinfo -F version "$m" 2>/dev/null | head -1))"
	fi
done
[ "$seen" -eq 1 ] || report driver-module "none installed ($MODULES)"
accels=$(find "$DEV_ACCEL" -mindepth 1 -maxdepth 1 2>/dev/null | sort)
if [ -n "$accels" ]; then
	for a in $accels; do report dev-accel "$(stat -c '%n %A' "$a")"; done
else
	report dev-accel "no /dev/accel node"
fi

# --- Probe 3: one model run attempt -----------------------------------------
if [ "${PROBE_SMOKE+set}" = set ]; then
	smoke=$PROBE_SMOKE
else
	smoke=$(command -v omarchy-ane-smoke 2>/dev/null || true)
	[ -n "$smoke" ] || [ ! -x "$HERE/omarchy-ane-smoke" ] || smoke=$HERE/omarchy-ane-smoke
fi
if [ "${PROBE_CHECK+set}" = set ]; then
	check=$PROBE_CHECK
else
	check=$(command -v omarchy-ane-check 2>/dev/null || true)
	[ -n "$check" ] || [ ! -x "$HERE/omarchy-ane-check" ] || check=$HERE/omarchy-ane-check
fi
if [ -n "$smoke" ]; then
	out=$("$smoke" --timeout 30 2>&1)
	rc=$?
	line=$(printf '%s\n' "$out" | grep -v '^{' | tail -1)
	case $rc in
		0) report model-run "PASS — $line" ;;
		1) report model-run "FAIL — $line" ;;
		*) report model-run "NOT-RUN — $line" ;;
	esac
	json=$(printf '%s\n' "$out" | sed -n 's/^\({.*}\)$/\1/p' | tail -1)
	[ -z "$json" ] || report model-run-json "$json"
elif [ -n "$check" ]; then
	out=$("$check" --smoke 2>&1)
	rc=$?
	line=$(printf '%s\n' "$out" | tail -1)
	case $rc in
		0) report model-run "PASS — $line" ;;
		1) report model-run "FAIL — $line" ;;
		*) report model-run "NOT-RUN — $line" ;;
	esac
else
	report model-run "NOT-RUN — omarchy-ane-smoke is not installed; install omarchy-ane-dkms or run this script from an omarchy-ane checkout"
fi
echo "--- end ---"
echo "Add your Mac model (for example 'Mac Studio M1 Ultra') and paste the block into #304."
exit 0
