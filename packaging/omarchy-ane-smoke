"""Run the packaged add fixture 20 times on this Mac's ANE.

Each result hashes only the valid fp16 planes, in plane order as little-endian
16-bit values. H14 has 512 planes in a 32 KiB output; H13 has 64 planes in a
16 KiB tile. For H13 the complete output tile is compared with the model, including
zero padding. H13 inputs use channels 5 and 6 and output channel 4. H14 keeps
its valid-plane golden check.

Exit 0: every call is bit-exact. Exit 1: a call failed or mismatched. Exit 2:
no fixture, driver, firmware, or packaged file is available.
"""
import argparse
import fcntl
import hashlib
import json
import re
import shutil
import statistics
import struct
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from pathlib import Path

NAME = "add-fixture"
CALLS = 20
H14_LANES, H13_LANES, PLANE = 512, 64, 64
H14_SURFACE, H13_SURFACE = H14_LANES * PLANE, 16384
H14_ADD = "h14-anec/add/program-0.anec"
H13_ADD = "h13-anec/add/program-0.anec"
FIXTURE = {"t6020": H14_ADD, "t6021": H14_ADD, "t6022": H14_ADD, "t8112": H14_ADD,
           "t8103": H13_ADD, "t6000": H13_ADD, "t6001": H13_ADD, "t6002": H13_ADD}
H13 = {"t8103", "t6000", "t6001", "t6002"}
MODULE = {**{c: "ane" for c in H13}, **{c: "ane_t6021" for c in ("t6020", "t6021", "t6022", "t8112")}}
H14_GOLDEN = "94041b7cc10a66dfd76ecfd469728ad9d66f68b508f4a9744ce41208d6a4de0b"
H13_GOLDEN = "5ad7eccd2977a88a375f123fe42c6780855953a1e9df4ac442cae383bc240dd6"
GOLDEN = {chip: H13_GOLDEN if chip in H13 else H14_GOLDEN for chip in FIXTURE}
FIXTURES = "usr/share/omarchy-ane/fixtures"
DT = "sys/firmware/devicetree/base"
LOCK = "var/tmp/ane-run.lock"
TIME = re.compile(r"exec ms over 1 calls: min ([0-9.]+)")
HERE = Path(__file__).resolve().parent


class Unavailable(Exception):
    pass


def inputs(tag, lanes):
    bits = []
    for j in range(lanes):
        r = int.from_bytes(hashlib.sha256(f"{tag}{j}".encode()).digest()[:4], "little")
        bits.append((r >> 31) << 15 | (11 + (r >> 10) % 7) << 10 | (r & 0x3FF))
    return bits


def fp16_units(bits):
    sign, exp, frac = bits >> 15, (bits >> 10) & 31, bits & 1023
    value = frac if exp == 0 else (1024 + frac) << (exp - 1)
    return -value if sign else value


def round_fp16_units(value):
    """Encode exact 2^-24 units, rounding to nearest and ties away from zero."""
    sign = 0x8000 if value < 0 else 0
    n = abs(value)
    if n < 1024:
        return sign | n
    shift = max(n.bit_length() - 11, 0)
    quantum = 1 << shift
    n = ((n + quantum // 2) // quantum) * quantum
    exponent = n.bit_length() - 10
    significand = n >> (exponent - 1)
    if significand == 2048:
        exponent += 1
        significand = 1024
    return sign | (exponent << 10) | (significand - 1024)


def add_fp16(a, b):
    return round_fp16_units(fp16_units(a) + fp16_units(b))


def surface(bits, lanes):
    buf = bytearray(H13_SURFACE if lanes == H13_LANES else lanes * PLANE)
    for j, v in enumerate(bits):
        struct.pack_into("<H", buf, j * PLANE, v)
    return bytes(buf)


def valid(data, lanes):
    return b"".join(data[j * PLANE:j * PLANE + 2] for j in range(lanes))


def h13_inputs(tag):
    """64 exact quarter values, placed in the first fp16 of each H13 plane."""
    vals = [struct.unpack("<H", struct.pack("<e", (3 + (i * (1 if tag == "a" else 3)) % 11) / 4))[0]
            for i in range(H13_LANES)]
    return vals


def soc(root):
    try:
        names = (root / DT / "compatible").read_bytes().decode("ascii", "replace").split("\0")
    except OSError:
        return None
    return next((m.group(1) for m in map(re.compile(r"apple,(t\d+)").fullmatch, names) if m), None)


def tool(name, repo=None):
    import os
    from shutil import which
    for path in (HERE / name, which(name), repo and HERE.parent / repo):
        if path and path.is_file() and os.access(path, os.X_OK):
            return Path(path)
    return None


def prepare(root, chip):
    if chip is None:
        raise Unavailable(f"no Apple SoC in {root / DT}/compatible")
    if chip not in FIXTURE:
        raise Unavailable(f"{chip}: no omarchy-ane driver for this chip")
    rel = FIXTURE[chip]
    anec = next((d / rel for d in (root / FIXTURES, HERE.parent / "fixtures") if (d / rel).is_file()), None)
    if anec is None:
        raise Unavailable(f"{root / FIXTURES / rel} is missing. Reinstall omarchy-ane-dkms.")
    runner = tool("omarchy-ane-run", "tools/ane-run")
    if runner is None:
        raise Unavailable("omarchy-ane-run is missing. Reinstall omarchy-ane-dkms.")
    module = MODULE[chip]
    drivers = root / "sys/bus/platform/drivers" / module
    if not any(p.is_symlink() and p.name != "module" for p in drivers.glob("*")):
        why = f"{module} is bound to no device. Read the reason with: journalctl -k -g {module}"
        fetch = tool("omarchy-ane-firmware-fetch") if module == "ane_t6021" else None
        if fetch:
            p = subprocess.run([str(fetch), "--check", "--root", str(root)], capture_output=True, text=True,
                               timeout=30)
            if p.returncode and p.stderr.strip():
                why = p.stderr.strip().splitlines()[-1].removeprefix("omarchy-ane-firmware-fetch: ")
        raise Unavailable(why)
    return anec, runner


@contextmanager
def lock(path, deadline):
    import os
    if not os.access(path, os.W_OK):
        yield
        return
    with open(path, "a") as fh:
        while True:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise Unavailable(f"another ANE job held {path} past the time limit")
                time.sleep(0.1)
        yield


def calls(runner, anec, chip, deadline, limit):
    h13 = chip in H13
    lanes = H13_LANES if h13 else H14_LANES
    a_bits, b_bits = ((h13_inputs("a"), h13_inputs("b")) if h13 else (inputs("a", lanes), inputs("b", lanes)))
    expected_bits = [add_fp16(a, b) for a, b in zip(a_bits, b_bits)]
    expected = surface(expected_bits, lanes)
    golden = hashlib.sha256(valid(expected, lanes)).hexdigest()
    hashes, times, exact, problem = [], [], 0, None
    work = Path(tempfile.mkdtemp(prefix="omarchy-ane-smoke."))
    try:
        a, b, y = work / "a.fp16", work / "b.fp16", work / "y.fp16"
        a.write_bytes(surface(a_bits, lanes))
        b.write_bytes(surface(b_bits, lanes))
        io = ("5", "6", "4") if h13 else ("0", "1", "0")
        cmd = [str(runner), "--anec", str(anec), "--in", f"{io[0]}={a}", "--in", f"{io[1]}={b}",
               "--out", f"{io[2]}={y}"]
        if not h13:
            cmd += ["--check", "add"]
        cmd += ["--time"]
        for n in range(1, CALLS + 1):
            y.unlink(missing_ok=True)
            left = deadline - time.monotonic()
            if left <= 0:
                problem = problem or f"the {limit:g} s limit passed before call {n}"
                break
            try:
                p = subprocess.run(cmd, capture_output=True, text=True, timeout=left)
            except subprocess.TimeoutExpired:
                problem = problem or f"call {n} ran past the {limit:g} s limit"
                break
            data = y.read_bytes() if y.exists() else b""
            if len(data) != len(expected):
                problem = problem or f"call {n}: output surface has {len(data)} bytes; expected {len(expected)}"
                break
            digest = hashlib.sha256(valid(data, lanes)).hexdigest()
            hashes.append(digest)
            m = TIME.search(p.stdout)
            if m:
                times.append(float(m.group(1)))
            if p.returncode == 0 and (data == expected if h13 else digest == golden):
                exact += 1
            else:
                problem = problem or f"call {n}: output surface or runner status differs ({p.returncode})"
    finally:
        shutil.rmtree(work, ignore_errors=True)
    return hashes, times, exact, problem, golden


def emit(result, line, code):
    print(json.dumps(result))
    print(f"omarchy-ane-smoke: {line}", file=sys.stderr)
    return code


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--root", type=Path, default=Path("/"), help="system root (tests)")
    ap.add_argument("--timeout", type=float, default=60.0, help="limit for the whole run, in seconds")
    args = ap.parse_args(argv)
    deadline = time.monotonic() + args.timeout
    chip = soc(args.root)
    try:
        anec, runner = prepare(args.root, chip)
        with lock(args.root / LOCK, deadline):
            hashes, times, exact, problem, golden = calls(runner, anec, chip, deadline, args.timeout)
    except Unavailable as e:
        return emit({"name": NAME, "chip": chip, "available": False, "reason": str(e)}, f"unavailable: {e}", 2)
    errors = CALLS - exact
    result = {"name": NAME, "chip": chip, "available": True, "sha256": hashes, "golden_sha256": golden,
              "errors": errors, "min_ms": round(min(times), 3) if times else None,
              "median_ms": round(statistics.median(times), 3) if times else None}
    line = f"{NAME} on {chip}: {exact}/{CALLS} calls bit-exact"
    if times:
        line += f", min {result['min_ms']:.3f} ms, median {result['median_ms']:.3f} ms"
    if errors:
        result["reason"] = problem
        return emit(result, f"{line}; {problem}", 1)
    return emit(result, line, 0)


if __name__ == "__main__":
    sys.exit(main())
