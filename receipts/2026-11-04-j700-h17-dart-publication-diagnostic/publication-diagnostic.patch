+			}
 			if (!live || !owned || !ours) {
+				diag_result = "incomplete-root";
 				ret = -EIO;
 				goto out;
 			}
@@ -1068,17 +1154,37 @@ apple_dart_hw_sync_locked(struct io_pgtable_cfg *cfg,
 					WRITE_ONCE(owned[entry], next);
 				}
 				dma_wmb();
+				diag_result = "legacy-copy";
 				continue;
 			}
 			ret = apple_dart_publish_root(dart, live, owned, ours,
 						      dart->locked_fw[sid][idx],
 						      dart->pgsize / sizeof(*live));
-			if (ret)
+			if (ret) {
+				diag_result = "publish-error";
 				goto out;
+			}
 		}
 	}
 out:
+	if (diag && dart->h17_pub_diag_count < 64) {
+		seq = ++dart->h17_pub_diag_count;
+		apple_dart_h17_pub_capture(dart, cfg, samples);
+	}
 	spin_unlock_irqrestore(&dart->lock, flags);
+	/* Logging outside the table lock; seq identifies interleaved snapshots. */
+	if (seq)
+		for (n = 0; n < ARRAY_SIZE(samples); n++) {
+			const struct apple_dart_h17_pub_sample *s = &samples[n];
+
+			dev_info(dart->dev,
+				 "h17-pub seq=%u result=%s deferred=%u ret=%d levels=%u ttbrs=%u dva=%#llx index=%llu slot=%llu present=%#x host=%#llx owned=%#llx live=%#llx\n",
+				 seq, diag_result, defer_unknown, ret,
+				 cfg->apple_dart_cfg.n_levels,
+				 cfg->apple_dart_cfg.n_ttbrs,
+				 s->dva, s->index, s->slot, s->present,
+				 s->host, s->owned, s->live);
+		}
 	return ret;
 }
 
