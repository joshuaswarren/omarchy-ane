 /*
@@ -1009,12 +1015,87 @@ static int apple_dart_retire_error(struct apple_dart_stream_map *stream_map)
 	return ret;
 }
 
+struct apple_dart_h17_pub_sample {
+	u64 dva, host, owned, live;
+	u64 index, slot;
+	u32 present;
+};
+
+/* The addresses are rung-1 candidates, not pointers to dereference. */
+static const u64 apple_dart_h17_pub_candidates[] = {
+	0x10000000000ULL, 0x3ffffbb0800ULL, 0xffbb0800ULL,
+};
+
+static bool apple_dart_h17_pub_enabled(struct apple_dart *dart,
+				     struct apple_dart_stream_map *map)
+{
+	const char *name = dev_name(dart->dev);
+
+	return h17_pub_diag && dart->locked &&
+		of_device_is_compatible(dart->dev->of_node, "apple,t8140-dart") &&
+		test_bit(0, map->sidmap) &&
+		bitmap_weight(map->sidmap, dart->num_streams) == 1 &&
+		(!strcmp(name, "401800000.iommu") ||
+		 !strcmp(name, "401820000.iommu") ||
+		 !strcmp(name, "401840000.iommu"));
+}
+
+/* Caller holds dart->lock. Only read already mapped driver table memory. */
+static void apple_dart_h17_pub_capture(struct apple_dart *dart,
+				      struct io_pgtable_cfg *cfg,
+				      struct apple_dart_h17_pub_sample *sample)
+{
+	u32 pgshift = ilog2(dart->pgsize);
+	u32 bits = pgshift - ilog2(sizeof(u64));
+	u64 entries = dart->pgsize / sizeof(u64);
+	unsigned int n;
+
+	for (n = 0; n < ARRAY_SIZE(apple_dart_h17_pub_candidates); n++) {
+		struct apple_dart_h17_pub_sample *s = &sample[n];
+		u64 *live, *owned, *host;
+
+		s->dva = apple_dart_h17_pub_candidates[n];
+		if (cfg->apple_dart_cfg.n_levels != 3 &&
+		    cfg->apple_dart_cfg.n_levels != 4)
+			continue;
+		s->index = cfg->apple_dart_cfg.n_levels == 4 ? 0 :
+			s->dva >> (pgshift + 2 * bits);
+		s->slot = (s->dva >> (pgshift +
+			(cfg->apple_dart_cfg.n_levels - 2) * bits)) & (entries - 1);
+		if (s->index >= DART_MAX_TTBR ||
+		    s->index >= cfg->apple_dart_cfg.n_ttbrs)
+			continue;
+		live = dart->locked_ttbr[0][s->index];
+		owned = dart->locked_owned[0][s->index];
+		host = cfg->apple_dart_cfg.ttbr[s->index];
+		if (host) {
+			s->host = READ_ONCE(host[s->slot]);
+			s->present |= BIT(0);
+		}
+		/* Retirement clears live under this lock, then frees owned
+		 * outside it. A residual owned pointer alone is not safe to read.
+		 */
+		if (live && owned) {
+			s->owned = READ_ONCE(owned[s->slot]);
+			s->present |= BIT(1);
+		}
+		if (live) {
+			s->live = READ_ONCE(live[s->slot]);
+			s->present |= BIT(2);
+		}
+	}
+}
+
 static int
 apple_dart_hw_sync_locked(struct io_pgtable_cfg *cfg,
 			 struct apple_dart_stream_map *stream_map,
 			 bool defer_unknown)
 {
 	struct apple_dart *dart = stream_map->dart;
+	struct apple_dart_h17_pub_sample samples[3] = {};
+	bool diag = apple_dart_h17_pub_enabled(dart, stream_map);
+	const char *diag_result = "published";
+	unsigned int seq = 0, n;
 	unsigned long flags;
 	int sid, idx, ret = 0;
 
@@ -1030,8 +1111,10 @@ apple_dart_hw_sync_locked(struct io_pgtable_cfg *cfg,
 					break;
 				}
 			}
-			if (!ready)
+			if (!ready) {
