+/* Temporary H17 bring-up diagnostic. Boot-time opt-in only; never writes MMIO. */
+static bool h17_pub_diag;
+module_param_named(h17_pub_diag, h17_pub_diag, bool, 0400);
+MODULE_PARM_DESC(h17_pub_diag, "Bounded ANE locked-root publication snapshots");
