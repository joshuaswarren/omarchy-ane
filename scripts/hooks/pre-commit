#!/bin/sh
# COS-290: never commit as AneRecover / machine hostname / bot identity.
set -e
NAME=$(git config --get user.name || true)
EMAIL=$(git config --get user.email || true)
AUTHOR_NAME=${GIT_AUTHOR_NAME:-$NAME}
AUTHOR_EMAIL=${GIT_AUTHOR_EMAIL:-$EMAIL}
COMMITTER_NAME=${GIT_COMMITTER_NAME:-$NAME}
COMMITTER_EMAIL=${GIT_COMMITTER_EMAIL:-$EMAIL}

bad() {
  echo "COS-290 git identity guard: refusing commit with non-Joshua author/committer:" >&2
  echo "  author=$AUTHOR_NAME <$AUTHOR_EMAIL>" >&2
  echo "  committer=$COMMITTER_NAME <$COMMITTER_EMAIL>" >&2
  echo "Set user.name/user.email to Joshua Warren <816217+joshuaswarren@users.noreply.github.com> (or unset GIT_AUTHOR_* / GIT_COMMITTER_*)." >&2
  exit 1
}

echo "$AUTHOR_NAME$COMMITTER_NAME" | grep -Eqi 'AneRecover|ane-recover' && bad
echo "$AUTHOR_EMAIL$COMMITTER_EMAIL" | grep -Eqi 'AneRecover|ane-recover@|@homelab\.local$' && bad

case "$AUTHOR_EMAIL" in
  ""|816217+joshuaswarren@users.noreply.github.com) ;;
  *)
    echo "COS-290 git identity guard: author email must be 816217+joshuaswarren@users.noreply.github.com (got $AUTHOR_EMAIL)" >&2
    exit 1
    ;;
esac

REPO=$(git rev-parse --show-toplevel) || exit 1
export PRIVACY_REPO="$REPO"
if [ -f "$REPO/.git/hooks/privacy_check.py" ]; then
  python3 "$REPO/.git/hooks/privacy_check.py" --staged 2>&1 || exit $?
fi
exit 0
