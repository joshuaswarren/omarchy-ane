#!/bin/sh
# COS-290: use the contributor's global identity, never an agent identity.
id="$HOME/.config/git/identity-check"; if [ -x "$id" ]; then "$id" || exit 1; fi
set -e
NAME=$(git config --global --get user.name || true)
EMAIL=$(git config --global --get user.email || true)
AUTHOR_NAME=${GIT_AUTHOR_NAME:-$NAME}
AUTHOR_EMAIL=${GIT_AUTHOR_EMAIL:-$EMAIL}
COMMITTER_NAME=${GIT_COMMITTER_NAME:-$NAME}
COMMITTER_EMAIL=${GIT_COMMITTER_EMAIL:-$EMAIL}

bad() {
  echo "COS-290 git identity guard: refusing a commit that differs from the contributor's global identity:" >&2
  echo "  author=$AUTHOR_NAME <$AUTHOR_EMAIL>" >&2
  echo "  committer=$COMMITTER_NAME <$COMMITTER_EMAIL>" >&2
  echo "Set your global Git identity and remove repository-local or GIT_AUTHOR_*/GIT_COMMITTER_* overrides." >&2
  exit 1
}

[ -n "$NAME" ] && [ -n "$EMAIL" ] || bad
[ "$(git config --get user.name || true)" = "$NAME" ] || bad
[ "$(git config --get user.email || true)" = "$EMAIL" ] || bad
[ "$AUTHOR_NAME" = "$NAME" ] && [ "$AUTHOR_EMAIL" = "$EMAIL" ] || bad
[ "$COMMITTER_NAME" = "$NAME" ] && [ "$COMMITTER_EMAIL" = "$EMAIL" ] || bad

echo "$AUTHOR_NAME$COMMITTER_NAME" | grep -Eqi 'AneRecover|ane-recover|homelab\.local|omp-|@.*local$' && bad
echo "$AUTHOR_EMAIL$COMMITTER_EMAIL" | grep -Eqi 'AneRecover|ane-recover@|@homelab\.local$|localhost' && bad

REPO=$(git rev-parse --show-toplevel) || exit 1
if [ -x "$REPO/.git/hooks/privacy_check.py" ] || [ -f "$REPO/.git/hooks/privacy_check.py" ]; then
  python3 "$REPO/.git/hooks/privacy_check.py" --staged 2>&1 || exit $?
fi
exit 0
