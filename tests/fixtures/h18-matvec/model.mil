program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3520.4.1"}, {"coremlc-version", "3520.5.1"}})]
{
    func main<ios18>(tensor<fp16, [1, 1, 64, 64]> a, tensor<fp16, [1, 1, 64, 1]> b) {
        bool f = const()[name = string("f"), val = bool(false)];
        tensor<fp16, [1, 1, 64, 1]> y = matmul(transpose_x = f, transpose_y = f, x = a, y = b)[name = string("y")];
    } -> (y);
}
